# ── CUDA toolkit for NVIDIA Blackwell GB10 (DGX Spark, aarch64/SBSA) ──
# Adds NVIDIA's network repo and installs nvcc + headers for CUDA 12.8.
# The driver (CUDA 13.0) is already present in the container image.
wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/sbsa/cuda-keyring_1.1-1_all.deb
dpkg -i cuda-keyring_1.1-1_all.deb
rm -f cuda-keyring_1.1-1_all.deb
apt-get update
apt-get install -y cuda-toolkit-12-8

# Make nvcc available in PATH for the current session and all future shells.
# /etc/profile.d/ is sourced by bash for every login and interactive shell,
# which means `make` subprocesses spawned from a fresh terminal also see it.
# (Note: cmake detects nvcc via direct filesystem glob in CMakeLists.txt and
# does NOT require PATH to be set — this export is for interactive use only.)
export PATH=/usr/local/cuda-12.8/bin:$PATH
export LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:$LD_LIBRARY_PATH
cat > /etc/profile.d/cuda-12.8.sh << 'EOF'
export PATH=/usr/local/cuda-12.8/bin:${PATH}
export LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH}
EOF
